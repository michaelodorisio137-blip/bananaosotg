{
  "name": "RG DS Classic Clock",
  "author": "RG DS custom firmware",
  "base": "light",
  "accent": "#598fc1",
  "colors": {
    "screenBg": "#eaf2fa",
    "ink": "#243a50",
    "muted": "#607689"
  },
  "font": "inter",
  "vars": {
    "bg": "#eaf2fa",
    "card": "#ffffff",
    "ink": "#243a50",
    "soft": "#607689",
    "hi": "#598fc1"
  },
  "input": {
    "library": {
      "up": "prev",
      "down": "next",
      "left": "prev:5",
      "right": "next:5"
    }
  },
  "behavior": {
    "launchMs": 700,
    "scrollMs": 90,
    "cues": {
      "insert": 450
    },
    "fps": 1
  },
  "components": {
    "status": {
      "type": "group",
      "x": 0,
      "y": 0,
      "w": "100%",
      "h": 36,
      "children": [
        {
          "type": "text",
          "x": 20,
          "y": 10,
          "text": "{clock}",
          "font": "inter-semibold",
          "size": 15,
          "color": "=ink"
        },
        {
          "type": "text",
          "right": 20,
          "y": 10,
          "w": 120,
          "align": "right",
          "text": "=battery < 0 ? '' : battery + '%'",
          "size": 13,
          "color": "=soft"
        },
        {
          "type": "rect",
          "right": 146,
          "y": 13,
          "w": 26,
          "h": 12,
          "radius": 3,
          "border": 1.5,
          "borderColor": "=soft",
          "visible": "=battery >= 0"
        },
        {
          "type": "rect",
          "right": 148,
          "y": 15,
          "w": "=22 * battery / 100",
          "h": 8,
          "radius": 1.5,
          "fill": "=battery < 20 ? '#ff5a5a' : hi",
          "visible": "=battery >= 0"
        }
      ]
    },
    "hint": {
      "type": "group",
      "layout": "row",
      "gap": 6,
      "align": "center",
      "h": 24,
      "children": [
        {
          "type": "group",
          "layout": "row",
          "padding": 5,
          "h": 22,
          "fill": "=ink",
          "radius": 11,
          "children": [
            {
              "type": "text",
              "y": -2,
              "text": "{item.key}",
              "font": "inter-bold",
              "size": 12,
              "color": "=bg"
            }
          ]
        },
        {
          "type": "text",
          "text": "{item.label}",
          "size": 13,
          "color": "=soft",
          "y": 3
        }
      ]
    }
  },
